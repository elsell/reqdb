{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reqdb:schema:profile:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "project_id",
    "standard",
    "standard_url",
    "baseline_ref",
    "yaml",
    "levels",
    "types",
    "statuses",
    "verification_methods",
    "lease_ttl_seconds"
  ],
  "properties": {
    "schema": {"const": "reqdb-profile/v1"},
    "name": {"const": "ieee-29148-2018-simple-v1"},
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "standard": {"const": "ISO/IEC/IEEE 29148:2018"},
    "standard_url": {
      "const": "https://www.iso.org/standard/72089.html"
    },
    "baseline_ref": {"type": "string", "minLength": 1},
    "yaml": {"const": "1.2"},
    "levels": {
      "const": {
        "business": {
          "specification": "BRS",
          "id_prefix": "BR",
          "parent": null
        },
        "stakeholder": {
          "specification": "StRS",
          "id_prefix": "STR",
          "parent": "business"
        },
        "system": {
          "specification": "SyRS",
          "id_prefix": "SYR",
          "parent": "stakeholder"
        },
        "software": {
          "specification": "SRS",
          "id_prefix": "SWR",
          "parent": "system"
        }
      }
    },
    "types": {
      "const": [
        "functional",
        "performance",
        "interface",
        "quality",
        "constraint",
        "safety",
        "security"
      ]
    },
    "statuses": {"const": ["draft", "approved", "retired"]},
    "verification_methods": {
      "const": ["analysis", "demonstration", "inspection", "test"]
    },
    "lease_ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    }
  }
}
