{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reqdb:schema:task:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "description",
    "priority",
    "requirements",
    "depends_on"
  ],
  "properties": {
    "schema": {"const": "task/v1"},
    "id": {"type": "string", "pattern": "^T-[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "purpose"],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^(BR|STR|SYR|SWR)-[A-Z0-9]+(?:-[A-Z0-9]+)*@[1-9][0-9]*$"
          },
          "purpose": {"enum": ["implement", "reconcile"]}
        }
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^T-[0-9]+$"}
    }
  }
}
